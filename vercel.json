{
  "version": 2,
  "builds": [
    {
      "src": ".vercel/output/functions/__server.func/index.mjs",
      "use": "@vercel/node",
      "config": {
        "runtime": "nodejs22.x"
      }
    }
  ],
  "routes": [
    {
      "src": "/_nitro/(.*)",
      "dest": "/.vercel/output/functions/__server.func/index.mjs"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/.vercel/output/functions/__server.func/index.mjs"
    }
  ]
}
